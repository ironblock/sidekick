            tensor<fp16, [1, 16, 64]> clip_1_cast_fp16 = clip(alpha = const_14_to_fp16, beta = var_247_to_fp16, x = linear_11_cast_fp16)[name = string("clip_1_cast_fp16")];
            tensor<fp16, [1, 16, 64]> var_381_cast_fp16 = exp(x = clip_1_cast_fp16)[name = string("op_381_cast_fp16")];
            tensor<fp16, [1, 16, 64]> var_382_cast_fp16 = mul(x = var_379_cast_fp16, y = var_381_cast_fp16)[name = string("op_382_cast_fp16")];
            tensor<fp16, [1, 16, 64]> var_383_cast_fp16 = abs(x = linear_11_cast_fp16)[name = string("op_383_cast_fp16")];
            fp16 const_15_promoted_to_fp16 = const()[name = string("const_15_promoted_to_fp16"), val = fp16(-0x1p+0)];
            tensor<fp16, [1, 16, 64]> var_384_cast_fp16 = mul(x = var_383_cast_fp16, y = const_15_promoted_to_fp16)[name = string("op_384_cast_fp16")];
            tensor<fp16, [1, 16, 64]> var_385_cast_fp16 = exp(x = var_384_cast_fp16)[name = string("op_385_cast_fp16")];
            fp16 var_386_to_fp16 = const()[name = string("op_386_to_fp16"), val = fp16(0x1p+0)];
            tensor<fp16, [1, 16, 64]> var_387_cast_fp16 = add(x = var_385_cast_fp16, y = var_386_to_fp16)[name = string("op_387_cast_fp16")];
            tensor<fp16, [1, 16, 64]> var_388_cast_fp16 = real_div(x = var_382_cast_fp16, y = var_387_cast_fp16)[name = string("op_388_cast_fp16")];
            tensor<fp16, [64, 32]> layers_1_mlp_up_proj_weight_to_fp16 = const()[name = string("layers_1_mlp_up_proj_weight_to_fp16"), val = tensor<fp16, [64, 32]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(32448)))];
            tensor<fp16, [64]> linear_12_bias_0_to_fp16 = const()[name = string("linear_12_bias_0_to_fp16"), val = tensor<fp16, [64]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(36608)))];
            tensor<fp16, [1, 16, 64]> linear_12_cast_fp16 = linear(bias = linear_12_bias_0_to_fp16, weight = layers_1_mlp_up_proj_weight_to_fp16, x = hidden_states_79_cast_fp16)[name = string("linear_12_cast_fp16")];
            tensor<fp16, [1, 16, 64]> input_11_cast_fp16 = mul(x = var_388_cast_fp16, y = linear_12_cast_fp16)[name = string("input_11_cast_fp16")];
