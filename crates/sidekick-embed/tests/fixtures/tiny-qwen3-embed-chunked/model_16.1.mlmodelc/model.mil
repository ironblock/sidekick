            tensor<fp16, [1, 16, 64]> var_379_cast_fp16 = mul(x = linear_11_cast_fp16, y = var_378_to_fp16)[name = string("op_379_cast_fp16")];
            fp16 const_14_to_fp16 = const()[name = string("const_14_to_fp16"), val = fp16(-inf)];
