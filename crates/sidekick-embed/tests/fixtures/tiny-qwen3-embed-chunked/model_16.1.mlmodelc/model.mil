            tensor<fp16, [1, 16]> var_433_cast_fp16 = pad(constant_val = const_16_to_fp16, mode = var_433_mode_0, pad = var_433_pad_0, x = input_cast_fp16)[name = string("op_433_cast_fp16")];
            fp16 var_434_to_fp16 = const()[name = string("op_434_to_fp16"), val = fp16(0x1p+0)];
