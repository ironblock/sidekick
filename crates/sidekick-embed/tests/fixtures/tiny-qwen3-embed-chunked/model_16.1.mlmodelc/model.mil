            fp16 var_407_to_fp16 = const()[name = string("op_407_to_fp16"), val = fp16(0x1.1p-20)];
            tensor<fp16, [1, 16, 1]> var_408_cast_fp16 = add(x = variance_cast_fp16, y = var_407_to_fp16)[name = string("op_408_cast_fp16")];
            fp32 var_409_epsilon_0 = const()[name = string("op_409_epsilon_0"), val = fp32(0x1.197998p-40)];
            tensor<fp16, [1, 16, 1]> var_409_cast_fp16 = rsqrt(epsilon = var_409_epsilon_0, x = var_408_cast_fp16)[name = string("op_409_cast_fp16")];
            tensor<fp16, [1, 16, 32]> hidden_states_89_cast_fp16 = mul(x = hidden_states_85_cast_fp16, y = var_409_cast_fp16)[name = string("hidden_states_89_cast_fp16")];
            tensor<int32, [2]> input_begin_0 = const()[name = string("input_begin_0"), val = tensor<int32, [2]>([0, 1])];
