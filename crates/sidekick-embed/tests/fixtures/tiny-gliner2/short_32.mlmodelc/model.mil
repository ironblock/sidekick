            tensor<int32, [1]> var_60_axes_0 = const()[name = string("op_60_axes_0"), val = tensor<int32, [1]>([1])];
            bool var_60_keep_dims_0 = const()[name = string("op_60_keep_dims_0"), val = bool(true)];
