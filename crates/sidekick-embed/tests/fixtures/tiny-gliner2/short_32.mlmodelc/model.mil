            tensor<fp16, [1, 32, 8]> input_cast_fp16 = tanh(x = var_67_cast_fp16)[name = string("input_cast_fp16")];
            tensor<fp16, [1, 8]> w_weight_to_fp16 = const()[name = string("w_weight_to_fp16"), val = tensor<fp16, [1, 8]>([[0x1.734p-5, 0x1.dd8p-3, 0x1.428p-2, 0x1.b84p-3, -0x1.33cp-4, -0x1.424p-3, 0x1.99cp-4, 0x1.268p-2]])];
