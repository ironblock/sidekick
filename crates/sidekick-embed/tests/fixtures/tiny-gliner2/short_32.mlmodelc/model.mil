program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.13.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<int32, [1, 32]> attention_mask, tensor<int32, [1, 32]> input_ids) {
            tensor<int32, [1]> m_axes_0 = const()[name = string("m_axes_0"), val = tensor<int32, [1]>([2])];
