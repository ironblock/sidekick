            int32 slice_by_index_0 = const()[name = string("slice_by_index_0"), val = int32(32)];
            tensor<int32, [1, 32]> add_0 = add(x = cast_4, y = slice_by_index_0)[name = string("add_0")];
            tensor<int32, [1, 32]> select_0 = select(a = cast_4, b = add_0, cond = greater_equal_0)[name = string("select_0")];
            int32 var_20_cast_fp16_cast_uint16_axis_0 = const()[name = string("op_20_cast_fp16_cast_uint16_axis_0"), val = int32(0)];
