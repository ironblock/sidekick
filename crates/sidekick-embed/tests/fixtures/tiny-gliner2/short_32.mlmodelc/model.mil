            int32 var_20_batch_dims_0 = const()[name = string("op_20_batch_dims_0"), val = int32(0)];
            bool var_20_validate_indices_0 = const()[name = string("op_20_validate_indices_0"), val = bool(false)];
            tensor<fp16, [32, 8]> emb_weight_to_fp16 = const()[name = string("emb_weight_to_fp16"), val = tensor<fp16, [32, 8]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            string input_ids_to_int16_dtype_0 = const()[name = string("input_ids_to_int16_dtype_0"), val = string("int16")];
            string cast_4_dtype_0 = const()[name = string("cast_4_dtype_0"), val = string("int32")];
            int32 greater_equal_0_y_0 = const()[name = string("greater_equal_0_y_0"), val = int32(0)];
            tensor<int16, [1, 32]> input_ids_to_int16 = cast(dtype = input_ids_to_int16_dtype_0, x = input_ids)[name = string("cast_8")];
            tensor<int32, [1, 32]> cast_4 = cast(dtype = cast_4_dtype_0, x = input_ids_to_int16)[name = string("cast_7")];
