            tensor<fp16, [1, 32, 8]> h_cast_fp16 = mul(x = var_20_cast_fp16_cast_uint16_cast_uint16, y = m_cast_fp16)[name = string("h_cast_fp16")];
            tensor<int32, [3]> var_31_begin_0 = const()[name = string("op_31_begin_0"), val = tensor<int32, [3]>([0, 1, 0])];
