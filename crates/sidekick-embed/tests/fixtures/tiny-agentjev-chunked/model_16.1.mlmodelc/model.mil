            tensor<fp16, [32]> scorer_norm_weight_to_fp16 = const()[name = string("scorer_norm_weight_to_fp16"), val = tensor<fp16, [32]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(59456)))];
            tensor<fp16, [1, 4, 32]> input_41_cast_fp16 = mul(x = var_705_cast_fp16, y = scorer_norm_weight_to_fp16)[name = string("input_41_cast_fp16")];
            tensor<fp16, [16, 32]> scorer_fc1_weight_to_fp16 = const()[name = string("scorer_fc1_weight_to_fp16"), val = tensor<fp16, [16, 32]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(59584)))];
            tensor<fp16, [16]> scorer_fc1_bias_to_fp16 = const()[name = string("scorer_fc1_bias_to_fp16"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(60672)))];
            tensor<fp16, [1, 4, 16]> linear_24_cast_fp16 = linear(bias = scorer_fc1_bias_to_fp16, weight = scorer_fc1_weight_to_fp16, x = input_41_cast_fp16)[name = string("linear_24_cast_fp16")];
            tensor<fp16, [1, 4, 16]> input_cast_fp16 = silu(x = linear_24_cast_fp16)[name = string("input_cast_fp16")];
            tensor<fp16, [1, 16]> scorer_fc2_weight_to_fp16 = const()[name = string("scorer_fc2_weight_to_fp16"), val = tensor<fp16, [1, 16]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(60800)))];
            tensor<fp16, [1]> scorer_fc2_bias_to_fp16 = const()[name = string("scorer_fc2_bias_to_fp16"), val = tensor<fp16, [1]>([0x1.67p-3])];
            tensor<fp16, [1, 4, 1]> linear_25_cast_fp16 = linear(bias = scorer_fc2_bias_to_fp16, weight = scorer_fc2_weight_to_fp16, x = input_cast_fp16)[name = string("linear_25_cast_fp16")];
            tensor<int32, [1]> logits_axes_0 = const()[name = string("logits_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [1, 4]> logits_cast_fp16 = squeeze(axes = logits_axes_0, x = linear_25_cast_fp16)[name = string("logits_cast_fp16")];
            tensor<fp16, [1, 4]> var_715_cast_fp16 = mul(x = logits_cast_fp16, y = var_494_to_fp16)[name = string("op_715_cast_fp16")];
            fp16 var_717_to_fp16 = const()[name = string("op_717_to_fp16"), val = fp16(0x1p+0)];
            tensor<fp16, [1, 4]> var_718_cast_fp16 = sub(x = var_494_to_fp16, y = var_717_to_fp16)[name = string("op_718_cast_fp16")];
            fp16 var_719_to_fp16 = const()[name = string("op_719_to_fp16"), val = fp16(0x1.388p+13)];
            tensor<fp16, [1, 4]> var_720_cast_fp16 = mul(x = var_718_cast_fp16, y = var_719_to_fp16)[name = string("op_720_cast_fp16")];
            tensor<fp16, [1, 4]> logits = add(x = var_715_cast_fp16, y = var_720_cast_fp16)[name = string("op_722_cast_fp16")];
        } -> (logits);
}