{#- A hand-written template in the style of Llama 3's, for the renderer's
    fixtures: transformers' globals and filters (strftime_now, tojson with
    its arguments) and the {% generation %} block. -#}
{{- bos_token }}
{%- if not date_string is defined %}
    {%- if strftime_now is defined %}
        {%- set date_string = strftime_now("%d %b %Y") %}
    {%- else %}
        {%- set date_string = "26 Jul 2024" %}
    {%- endif %}
{%- endif %}
{{- "<|start_header_id|>system<|end_header_id|>\n\n" }}
{{- "Today Date: " + date_string + "\n\n" }}
{%- if messages[0]['role'] == 'system' %}
    {{- messages[0]['content'] | trim }}
    {%- set loop_messages = messages[1:] %}
{%- else %}
    {%- set loop_messages = messages %}
{%- endif %}
{{- "<|eot_id|>" }}
{%- for message in loop_messages %}
    {{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' }}
    {%- if message['role'] == 'assistant' %}
        {%- generation %}
        {{- message['content'] | trim }}
        {%- endgeneration %}
    {%- else %}
        {{- message['content'] | trim }}
    {%- endif %}
    {{- '<|eot_id|>' }}
{%- endfor %}
{{- '<|start_header_id|>meta<|end_header_id|>\n\n' }}
{{- loop_messages | tojson }}
{{- '\n' }}
{{- loop_messages[-1] | tojson(indent=2, ensure_ascii=True) }}
{{- '\n' }}
{{- {'turns': loop_messages | length, 'last': loop_messages[-1]['role']} | tojson(separators=(',', ':'), sort_keys=True) }}
{{- '<|eot_id|>' }}
{%- if add_generation_prompt %}
    {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
{%- endif %}
